{
  "name": "mavenpublications",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-13",
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/portal.html",
      "/portal",
      "/play/*",
      "/account",
      "/account.html"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VAULT",
        "class_name": "CaseVault"
      }
    ]
  },
  "migrations": [
    {
      "tag": "case-vault-v1",
      "new_sqlite_classes": [
        "CaseVault"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "SEASONS_MEDIA",
      "bucket_name": "maven-mystery-seasons-private"
    }
  ],
  "previews": {
    "r2_buckets": [
      {
        "binding": "SEASONS_MEDIA",
        "bucket_name": "maven-mystery-seasons-private"
      }
    ],
    "durable_objects": {
      "bindings": [
        {
          "name": "VAULT",
          "class_name": "CaseVault"
        }
      ]
    }
  }
}
